# Loaded automatically by `vite build` (mode=production is the default for build)
# or `vite build --mode production`.
# Replace the placeholder domains below with the real production values.
VITE_APP_ENV=production

VITE_API_BASE_URL=https://api.your-domain.example
VITE_API_PROXY_TARGET=https://api.your-domain.example

VITE_OIDC_AUTHORITY=https://identity.your-domain.example
VITE_OIDC_CLIENT_ID=react_tutorial_client
