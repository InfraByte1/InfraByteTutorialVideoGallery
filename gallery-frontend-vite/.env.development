# Loaded automatically by `vite`/`vite build` when mode=development (the default for `npm run dev`).
VITE_APP_ENV=development

# Same-origin path; the Vite dev server proxy (see vite.config.ts) forwards
# anything under /api to VITE_API_PROXY_TARGET, so the browser never makes a
# cross-origin request. Trailing slash matters — see vite-env.d.ts.
VITE_API_BASE_URL=/api/
# VITE_API_PROXY_TARGET=https://localhost:5002
VITE_API_PROXY_TARGET=https://api.staging.infrabyte.com.au

VITE_OIDC_AUTHORITY=https://localhost:5020
VITE_OIDC_CLIENT_ID=infrabyte_tutorial_client

# Optional dev-only sign-in bypass — put a real access token in
# .env.development.local (gitignored) if you want it. Never set here.
# VITE_DEV_ACCESS_TOKEN=
