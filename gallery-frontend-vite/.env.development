# Loaded automatically by `vite`/`vite build` when mode=development (the default for `npm run dev`).
VITE_APP_ENV=development

# Same-origin path; the Vite dev server proxy (see vite.config.ts) forwards this
# to VITE_API_PROXY_TARGET, so the browser never makes a cross-origin request.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=https://localhost:5020

VITE_OIDC_AUTHORITY=https://localhost:5020
VITE_OIDC_CLIENT_ID=react_tutorial_client
