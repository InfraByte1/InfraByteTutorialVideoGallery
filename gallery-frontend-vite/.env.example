# This project uses Vite's mode-based env files instead of a single .env:
#   .env.development  (npm run dev / build:development)
#   .env.staging      (npm run dev:staging / build:staging)
#   .env.production   (npm run build / build:production)
#
# Those three are committed — they only hold non-secret, public config
# (VITE_* vars get inlined into the client bundle at build time regardless).
# Auth is pure PKCE (no client_secret involved), so there's nothing secret
# to keep out of them.

VITE_APP_ENV=development
VITE_API_BASE_URL=/api/
VITE_API_PROXY_TARGET=https://api.staging.infrabyte.com.au
VITE_OIDC_AUTHORITY=https://localhost:5020
VITE_OIDC_CLIENT_ID=infrabyte_tutorial_client

# Optional dev-only sign-in bypass (skips the OIDC redirect). This is a live
# bearer token, not a client credential — put it in a gitignored
# .env.development.local, never in a committed .env.* file.
# VITE_DEV_ACCESS_TOKEN=
