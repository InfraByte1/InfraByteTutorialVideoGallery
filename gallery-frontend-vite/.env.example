# This project uses Vite's mode-based env files instead of a single .env:
#   .env.development  (npm run dev / build:development)
#   .env.staging      (npm run dev:staging / build:staging)
#   .env.production   (npm run build / build:production)
#
# All three are committed since VITE_* vars are public — they get inlined into
# the client bundle at build time, so nothing secret belongs in any of them.
#
# For a personal local override (e.g. pointing dev at your own backend),
# create .env.development.local — it's gitignored via *.local and takes
# precedence over .env.development.

VITE_APP_ENV=development
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=https://localhost:5020
VITE_OIDC_AUTHORITY=https://localhost:5020
VITE_OIDC_CLIENT_ID=react_tutorial_client
