
REACT_APP_ENVIRONMENT=production
# REACT_APP_ENVIRONMENT=staging
# REACT_APP_ENVIRONMENT=dev

# CRA inlines a small webpack runtime script directly into index.html by
# default, which a strict Content-Security-Policy script-src would block
# unless 'unsafe-inline' is allowed. Disabling this keeps all JS in
# external files so the CSP in public/index.html doesn't need it.
INLINE_RUNTIME_CHUNK=false
